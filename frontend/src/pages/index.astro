---
import BaseLayout from "../layouts/BaseLayout.astro";
import QueueSections from "../components/QueueSections.astro";

const printers = [
	{
		lab: "Bambu Lab",
		name: "Bambu H2D Pro",
		status: "available",
		specs: [
			["Build volume", "350 × 320 × 325 mm"],
			["Kinematics", "Dual-Nozzle CoreXY"],
			["Chamber", "Active heating (up to 65°C)"],
			["Max hotend temp", "350°C"],
		],
	},
	{
		lab: "Prusa Research",
		name: "Prusa Core ONE+",
		status: "printing",
		specs: [
			["Build volume", "250 × 220 × 270 mm"],
			["Kinematics", "Fully Enclosed CoreXY"],
			["Chamber", "Active temperature regulation"],
			["Max hotend temp", "300°C"],
		],
	},
];

const hexPoints = (cx: number, cy: number) =>
	`${cx},${cy - 34} ${cx + 29.4},${cy - 17} ${cx + 29.4},${cy + 17} ${cx},${cy + 34} ${cx - 29.4},${cy + 17} ${cx - 29.4},${cy - 17}`;
const hexCenters = [[120, 40], [61, 91], [120, 91], [179, 91], [90, 142], [149, 142]];
---

<BaseLayout title="Queue | PrintHive" description="Live PrintHive queue — see what is printing, then submit your own 3D print.">
	<main class="page">
		<section class="hero" aria-label="Welcome">
			<div class="hero-stack">
				<h1><span class="hive">HIVE</span><br /><span class="sub">3d printing</span></h1>
				<div class="hero-actions">
					<a class="button primary" href="/submit">Submit a print</a>
					<a class="button" href="#printers">Available printers</a>
				</div>
			</div>
			<svg class="honeycomb" viewBox="0 0 240 190" aria-hidden="true" focusable="false">
				{hexCenters.map(([cx, cy]) => <polygon points={hexPoints(cx, cy)} fill="#efc84a" stroke="#252720" stroke-width="2" stroke-linejoin="round" />)}
			</svg>
		</section>

		<QueueSections />

		<section class="printers" id="printers" aria-labelledby="printers-title">
			<h2 id="printers-title">Available printers</h2>
			<div class="printer-grid">
				{printers.map((printer) => (
					<article class="printer-card">
						<div class="printer-top">
							<div>
								<p class="printer-lab">{printer.lab}</p>
								<h3 class="printer-name">{printer.name}</h3>
							</div>
							<span class:list={["badge", printer.status === "available" ? "badge-green" : "badge-amber"]}>
								● {printer.status === "available" ? "Available" : "Printing"}
							</span>
						</div>
						<dl class="printer-specs">
							{printer.specs.map(([label, value]) => (
								<div><dt>{label}</dt><dd>{value}</dd></div>
							))}
						</dl>
					</article>
				))}
			</div>
		</section>
	</main>
</BaseLayout>
