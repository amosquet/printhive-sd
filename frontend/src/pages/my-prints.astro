---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="My prints | PrintHive" description="Your submitted prints — queued, printing, ready for pickup (Final Design S5–S7).">
	<main class="page">
		<div id="queue-banner" hidden></div>
		<div class="queue-layout" id="queue-layout">
			<div class="queue-main" id="queue-main">
				<section class="queue-section" aria-label="My prints">
					<div class="section-head"><h2>My prints</h2><span class="count-chip">0</span></div>
					<div class="job-list">
						<div class="job-row">
							<div class="job-info">
								<p class="job-title">No prints yet</p>
								<p class="job-meta">Submit a print from the queue page and it will appear here.</p>
							</div>
						</div>
					</div>
				</section>
				<p class="queue-note">Updates every 15 seconds.</p>
			</div>
			<aside class="my-print" id="my-print" aria-label="My print status">
				<p class="panel-label">MY PRINT</p>
				<div class="panel-title-row"><h2 class="panel-title">No print yet</h2></div>
				<div class="slice-box">
					<p class="box-title">Nothing in your queue</p>
					<p>Submit a print and it will show up here — queued, then printing, then ready for pickup.</p>
				</div>
				<div class="panel-actions">
					<a class="button primary" href="/submit">Submit a print</a>
					<a class="button secondary" href="/">Back to queue</a>
				</div>
			</aside>
		</div>
	</main>
	<script>
		import "../scripts/queue-page.ts";
	</script>
</BaseLayout>
